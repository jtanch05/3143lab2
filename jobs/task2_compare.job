#!/bin/bash
#SBATCH --job-name=task2_compare
#SBATCH --time=00:10:00
#SBATCH --mem=16G
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=4
#SBATCH --ntasks-per-node=2
#SBATCH --partition=defq

# Usage: sbatch task2_compare.job [n] [repetitions]
# Defaults run the small correctness check once.
set -e
module load openmpi/4.1.5-gcc-11.2.0-ux65npg
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

n=${1:-100}
repetitions=${2:-1}

# Each submission has its own results folder, preserving previous runs.
cd "$SLURM_SUBMIT_DIR"
mkdir -p "task2_compare_$SLURM_JOB_ID"
cd "task2_compare_$SLURM_JOB_ID"

echo "n=$n repetitions=$repetitions"
echo "Nodes: $SLURM_JOB_NODELIST"
echo "MPI processes: $SLURM_NTASKS; CPUs per process: $SLURM_CPUS_PER_TASK"

for ((repeat = 1; repeat <= repetitions; repeat++))
do
    echo "=== task2: repeat $repeat ==="
    srun "../task2" "$n" "$OMP_NUM_THREADS" > "task2_run_$repeat.txt"
    cat "task2_run_$repeat.txt"

    echo "=== task2_static: repeat $repeat ==="
    srun "../task2_static" "$n" "$OMP_NUM_THREADS" > "task2_static_run_$repeat.txt"
    cat "task2_static_run_$repeat.txt"

    diff task2_primelist.txt task2_static_primelist.txt
    echo "PASS: all variant prime lists match for repeat $repeat"
done

wc -l task2_primelist.txt task2_static_primelist.txt
echo "Last prime in each file:"
tail -n 1 task2_primelist.txt
tail -n 1 task2_static_primelist.txt
echo "Results folder: $PWD"
